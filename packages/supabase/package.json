{
  "name": "@chelone/supabase",
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/supabase"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "bin": {
    "chelone-supabase": "./dist/codegen/bin.js"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chelone/core": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "supazod": "^4.5.0",
    "typescript": "^5.5.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "supazod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chelone/test-utils": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "supazod": "^4.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
