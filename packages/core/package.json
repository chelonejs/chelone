{
  "name": "@chelone/core",
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.es2020.json"
  },
  "peerDependencies": {
    "@tanstack/form-core": "^1.33.0",
    "@tanstack/query-core": "^5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@chelone/test-utils": "workspace:*",
    "@tanstack/form-core": "^1.33.5",
    "@tanstack/query-core": "^5.106.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^31.0.0",
    "papaparse": "^5.7.0",
    "publint": "^0.3.25",
    "terra-draw": "^1.39.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "dot.paths": "^0.2.2"
  }
}
