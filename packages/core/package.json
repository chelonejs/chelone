{
  "name": "@chelone/core",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:pack": "publint --pack pnpm --strict",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@tanstack/form-core": "^1.33.0",
    "@tanstack/query-core": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/form-core": "^1.33.0",
    "@tanstack/query-core": "^5.0.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
