      "./block-editor": {
        "types": "./dist/block-editor.d.ts",
        "default": "./dist/block-editor.js"
      },
      "./charts": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/strip-dts-css-imports.mjs dist && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only --exclude-entrypoints ./mdx-editor.css ./rich-text-input.css",
    "test": "vitest run --typecheck",
    "typecheck": "vue-tsc --noEmit",
    "registry:generate": "node ../../scripts/registry/generate-registry.mjs",
    "registry:build": "node ../../scripts/registry/build-registry.mjs",
    "registry:test-local": "node scripts/test-registry-local.mjs"
  },
