{
  "name": "@chelone/vue",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/r"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./monaco": "./src/monaco.ts",
    "./mdx-editor": "./src/mdx-editor.ts",
    "./mdx-editor.css": "./src/components/mdx-editor/mdx-editor-theme.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./monaco": {
        "types": "./dist/monaco.d.ts",
        "default": "./dist/monaco.js"
      },
      "./mdx-editor": {
        "types": "./dist/mdx-editor.d.ts",
        "default": "./dist/mdx-editor.js"
      },
      "./mdx-editor.css": "./dist/components/mdx-editor/mdx-editor-theme.css"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only --exclude-entrypoints ./mdx-editor.css",
    "test": "vitest run --typecheck",
    "typecheck": "vue-tsc --noEmit",
    "registry:generate": "node ../../scripts/registry/generate-registry.mjs",
    "registry:build": "node ../../scripts/registry/build-registry.mjs",
    "registry:test-local": "node scripts/test-registry-local.mjs"
  },
  "dependencies": {
    "@chelone/core": "workspace:*",
    "cronstrue": "^3.24.0",
    "libphonenumber-js": "^1.13.8"
  },
  "peerDependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@tanstack/vue-query": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@guolao/vue-monaco-editor": {
      "optional": true
    },
    "@milkdown/crepe": {
      "optional": true
    },
    "@milkdown/kit": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@tanstack/vue-query": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "monaco-editor": "^0.57.0",
    "publint": "^0.3.0",
    "shadcn-vue": "2.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0",
    "vue-tsc": "^2.0.0",
    "zod": "^3.24.0"
  }
}
