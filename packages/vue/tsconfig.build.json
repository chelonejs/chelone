{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/composables/*": ["./src/composables/*"],
      "@chelone/core": ["../core/dist/index.d.ts"]
    }
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test-d.ts"]
}
