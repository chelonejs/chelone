{
  "name": "@chelone/react",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/r"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/rewrite-dts-aliases.mjs dist && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "registry:generate": "node scripts/generate-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:test-local": "node scripts/test-registry-local.mjs"
  },
  "dependencies": {
    "@chelone/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cronstrue": "^3.24.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.506.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-dropzone": "^14.3.8",
    "react-resizable-panels": "^4.11.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-store": "^0.11.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "react-router": {
      "optional": false
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-store": "^0.11.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.0.0",
    "publint": "^0.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.0.0",
    "shadcn": "4.11.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
