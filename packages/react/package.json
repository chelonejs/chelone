{
  "name": "@chelone/react",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/r"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tanstack-router": "./src/tanstack-router.ts",
    "./monaco": "./src/monaco.ts",
    "./kanban": "./src/kanban.ts",
    "./csv-import": "./src/csv-import.ts",
    "./maps": "./src/maps.ts",
    "./maps/draw": "./src/maps-draw.ts",
    "./maps/osm": "./src/maps-osm.ts",
    "./supabase": "./src/supabase.ts",
    "./mdx-editor": "./src/mdx-editor.ts",
    "./mdx-editor.css": "./src/components/mdx-editor/mdx-editor-dark.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tanstack-router": {
        "types": "./dist/tanstack-router.d.ts",
        "default": "./dist/tanstack-router.js"
      },
      "./monaco": {
        "types": "./dist/monaco.d.ts",
        "default": "./dist/monaco.js"
      },
      "./kanban": {
        "types": "./dist/kanban.d.ts",
        "default": "./dist/kanban.js"
      },
      "./csv-import": {
        "types": "./dist/csv-import.d.ts",
        "default": "./dist/csv-import.js"
      },
      "./maps": {
        "types": "./dist/maps.d.ts",
        "default": "./dist/maps.js"
      },
      "./maps/draw": {
        "types": "./dist/maps-draw.d.ts",
        "default": "./dist/maps-draw.js"
      },
      "./maps/osm": {
        "types": "./dist/maps-osm.d.ts",
        "default": "./dist/maps-osm.js"
      },
      "./supabase": {
        "types": "./dist/supabase.d.ts",
        "default": "./dist/supabase.js"
      },
      "./mdx-editor": {
        "types": "./dist/mdx-editor.d.ts",
        "default": "./dist/mdx-editor.js"
      },
      "./mdx-editor.css": "./dist/components/mdx-editor/mdx-editor-dark.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/rewrite-dts-aliases.mjs dist && node scripts/strip-dts-css-imports.mjs dist && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only --exclude-entrypoints ./mdx-editor.css",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "registry:generate": "node ../../scripts/registry/generate-registry.mjs",
    "registry:build": "node ../../scripts/registry/build-registry.mjs",
    "registry:test-local": "node scripts/test-registry-local.mjs"
  },
  "dependencies": {
