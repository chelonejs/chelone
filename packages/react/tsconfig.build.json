{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      // Core's dist must exist: `turbo run build` builds it first (`^build`).
      "@chelone/core": ["../core/dist/index.d.ts"]
    }
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/test-setup.ts",
    "src/**/__fixtures__/**"
  ]
}
