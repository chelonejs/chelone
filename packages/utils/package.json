{
  "name": "@chelone/utils",
  "version": "0.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelonejs/chelone.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./cron": "./src/cron/index.ts",
    "./geo": "./src/geo/index.ts",
    "./osm": "./src/osm/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./cron": {
        "types": "./dist/cron/index.d.ts",
        "default": "./dist/cron/index.js"
      },
      "./geo": {
        "types": "./dist/geo/index.d.ts",
        "default": "./dist/geo/index.js"
      },
      "./osm": {
        "types": "./dist/osm/index.d.ts",
        "default": "./dist/osm/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/dts-extensions.mjs dist",
    "check:pack": "publint --pack pnpm --strict && d=$(mktemp -d) && trap 'rm -rf $d' EXIT && pnpm pack --pack-destination $d && attw $d/*.tgz --profile esm-only",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --typecheck --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chelone/core": "workspace:*",
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "@turf/buffer": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "cronstrue": "^3.24.0",
    "osm2geojson-lite": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "@turf/buffer": {
      "optional": true
    },
    "@turf/difference": {
      "optional": true
    },
    "@turf/simplify": {
      "optional": true
    },
    "@turf/union": {
      "optional": true
    },
    "cronstrue": {
      "optional": true
    },
    "osm2geojson-lite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tanstack/query-core": "^5.106.1",
    "@turf/buffer": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "cronstrue": "^3.38.0",
    "osm2geojson-lite": "^2.0.1",
    "publint": "^0.3.25",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
