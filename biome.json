{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**/*.ts", "**/*.tsx", "**/*.json", "**/*.jsonc"] },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      "includes": ["packages/react/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsForRole": "off",
            "useKeyWithClickEvents": "off",
            "noRedundantRoles": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/website/src/docs/**",
        "apps/website/src/components/site-shell/**",
        "apps/website/src/components/doc-search.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noDocumentCookie": "off",
            "noShadowRestrictedNames": "off",
            "useIterableCallbackReturn": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tanstack/react-form": "@chelone/core wraps @tanstack/form-core directly; the React bridge lives in @chelone/react (and never uses react-form — its useForm cannot accept an external FormApi).",
                  "@tanstack/react-store": "@chelone/core is vanilla TS — the react-store uSES bridge belongs in @chelone/react.",
                  "react": "@chelone/core is vanilla TS — no React. Put React code in @chelone/react.",
                  "react-dom": "@chelone/core must not import react-dom.",
                  "react-hook-form": "@chelone/core uses @tanstack/form-core, not react-hook-form.",
                  "react-router": "@chelone/core must not own a router; it owns the vanilla RouterPort seam and injects a RouterAdapter from @chelone/react.",
                  "@tanstack/react-router": "@chelone/core must not own a router; the tanstackRouterAdapter lives in @chelone/react. Core exposes the vanilla RouterPort + pure path utils only."
                }
              }
            }
          }
        }
      }
    }
  ]
}
