#!/bin/sh
set -e

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
tmp="$(mktemp -d "$(git rev-parse --absolute-git-dir)/pre-push.XXXXXX")"
trap 'git worktree remove --force "$tmp/tree" >/dev/null 2>&1 || true; rm -rf "$tmp"' EXIT

# Lint each commit being pushed as committed, not the working tree, so an
# unstaged `pnpm format` neither hides a bad commit nor blocks a clean one.
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  git worktree add --detach --quiet "$tmp/tree" "$local_sha"
  if ! (cd "$tmp/tree" && "$root/node_modules/.bin/biome" check .); then
    echo "pre-push: pnpm lint failed, run pnpm format and commit" >&2
    exit 1
  fi
  # A commit from before the check existed has no script or baseline to run.
  if [ -f "$tmp/tree/scripts/check-duplication.mjs" ] && [ -f "$tmp/tree/duplication-baseline.json" ] && [ -f "$tmp/tree/.jscpd.json" ]; then
    # A checkout installed before the check existed has no jscpd; CI still runs it.
    if [ ! -e "$root/node_modules/.bin/jscpd" ]; then
      echo "pre-push: jscpd is not installed, skipping the duplication check (run pnpm install; CI still runs it)" >&2
    elif ! (cd "$tmp/tree" && JSCPD_BIN="$root/node_modules/.bin/jscpd" node scripts/check-duplication.mjs); then
      echo "pre-push: pnpm check:duplication failed, remove the copy (see CLAUDE.md)" >&2
      exit 1
    fi
  fi
  git worktree remove --force "$tmp/tree"
done
