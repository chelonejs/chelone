    "@chelone/vue": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-store": "^0.11.2",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.69.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "react-shiki": "^0.11.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chelone/demo": "workspace:*",
