{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5373",
    "build": "react-router build && node scripts/copy-spa-fallback.mjs && node scripts/copy-demo.mjs && node scripts/copy-registry.mjs",
    "preview": "vite preview --outDir build/client --port 4373",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "typedoc": "typedoc --options scripts/typedoc.json",
    "props:generate": "node scripts/split-typedoc.mjs",
    "props:vue": "node scripts/vue-props.mjs",
    "props": "pnpm typedoc && pnpm props:generate && pnpm props:vue"
  },
  "dependencies": {
    "@chelone/core": "workspace:*",
