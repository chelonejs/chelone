    "twoslash-vue": "0.3.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-component-meta": "^3.3.14"
