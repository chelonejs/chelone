{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5373",
    "build": "react-router build && node scripts/copy-spa-fallback.mjs && node scripts/copy-demo.mjs",
    "preview": "vite preview --outDir build/client --port 4373",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "typedoc": "typedoc --options scripts/typedoc.json",
    "props:generate": "node scripts/split-typedoc.mjs",
    "props": "pnpm typedoc && pnpm props:generate"
  },
  "dependencies": {
    "@chelone/core": "workspace:*",
    "@chelone/react": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@react-router/node": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-store": "^0.11.0",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^0.506.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "react-shiki": "^0.7.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.2.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.5.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.0.0"
  }
}
