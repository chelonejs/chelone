{
  "name": "DrawToolbar",
  "props": [
    {
      "name": "active",
      "type": "DrawTool | null",
      "optional": false,
      "comment": "The pressed tool, or `null`."
    },
    {
      "name": "canDelete",
      "type": "boolean",
      "optional": true,
      "comment": "Enables the `delete` button. Defaults to false."
    },
    {
      "name": "className",
      "type": "string",
      "optional": true,
      "comment": ""
    },
    {
      "name": "disabled",
      "type": "boolean",
      "optional": true,
      "comment": "Disables every button."
    },
    {
      "name": "onChange",
      "type": "(tool: DrawTool | null) => void",
      "optional": false,
      "comment": "Called with the pressed tool, or `null` when the active one is pressed again."
    },
    {
      "name": "onDelete",
      "type": "() => void",
      "optional": true,
      "comment": "Called by the `delete` button."
    },
    {
      "name": "tools",
      "type": "readonly DrawTool | \"delete\"[]",
      "optional": false,
      "comment": "The buttons, in order. `delete` is an action on the selected feature, not a tool."
    }
  ]
}
