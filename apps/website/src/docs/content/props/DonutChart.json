{
  "name": "DonutChart",
  "props": [
    {
      "name": "bare",
      "type": "boolean",
      "optional": true,
      "comment": "Leaves out the card and the title."
    },
    {
      "name": "className",
      "type": "string",
      "optional": true,
      "comment": ""
    },
    {
      "name": "colors",
      "type": "readonly string[]",
      "optional": true,
      "comment": "Any CSS colors, cycled over the slices. Defaults to the theme's chart colors."
    },
    {
      "name": "data",
      "type": "readonly TRow[]",
      "optional": false,
      "comment": ""
    },
    {
      "name": "height",
      "type": "number",
      "optional": true,
      "comment": "In pixels. Defaults to 200."
    },
    {
      "name": "labelField",
      "type": "keyof TRow & string",
      "optional": false,
      "comment": ""
    },
    {
      "name": "loading",
      "type": "boolean",
      "optional": true,
      "comment": ""
    },
    {
      "name": "title",
      "type": "string",
      "optional": true,
      "comment": ""
    },
    {
      "name": "valueField",
      "type": "keyof TRow & string",
      "optional": false,
      "comment": "A row whose value is not a number above zero draws no slice."
    }
  ]
}
