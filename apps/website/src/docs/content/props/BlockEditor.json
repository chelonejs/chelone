{
  "name": "BlockEditor",
  "props": [
    {
      "name": "blocks",
      "type": "readonly BlockDefinition<Attrs>[]",
      "optional": true,
      "comment": "Read once, when the editor mounts. Names must be unique. Defaults to `defaultBlocks`."
    },
    {
      "name": "className",
      "type": "string",
      "optional": true,
      "comment": ""
    },
    {
      "name": "editable",
      "type": "boolean",
      "optional": true,
      "comment": ""
    },
    {
      "name": "onBlur",
      "type": "(event: FocusEvent) => void",
      "optional": true,
      "comment": ""
    },
    {
      "name": "onChange",
      "type": "(value: BlockDocNode) => void",
      "optional": true,
      "comment": ""
    },
    {
      "name": "placeholder",
      "type": "string",
      "optional": true,
      "comment": "Shown in an empty paragraph."
    },
    {
      "name": "value",
      "type": "BlockDocNode | null",
      "optional": true,
      "comment": "The document, as tiptap JSON. `null` or `undefined` is an empty document."
    }
  ]
}
