      "comment": ""
    },
    {
      "name": "label",
      "type": "string",
      "optional": false,
      "comment": ""
    },
    {
      "name": "loading",
      "type": "boolean",
      "optional": true,
      "comment": ""
    },
    {
      "name": "value",
      "type": "number | string",
      "optional": false,
      "comment": ""
    }
  ]
}
