{
  "name": "BarChart",
  "props": [
    {
      "name": "color",
      "type": "string",
      "optional": true,
      "comment": "Any CSS color. Left out, each bar draws in the next theme chart color."
    },
    {
      "name": "colors",
      "type": "readonly string[]",
      "optional": true,
      "default": "DEFAULT_CHART_COLORS",
      "comment": "Any CSS colors, cycled over the bars when `color` is left out. Defaults to the theme's chart colors."
    },
    {
      "name": "data",
      "type": "readonly TRow[]",
      "optional": false,
      "comment": ""
    },
    {
      "name": "xField",
      "type": "TX",
      "optional": false,
      "comment": ""
    },
    {
      "name": "yField",
      "type": "keyof TRow & string",
      "optional": false,
      "comment": "A row whose value is not a finite number draws no point or bar."
    },
    {
      "name": "title",
      "type": "string",
      "optional": true,
      "comment": ""
    },
    {
      "name": "height",
      "type": "number",
      "optional": true,
      "default": "200",
      "comment": "In pixels. Defaults to 200."
    },
    {
      "name": "loading",
      "type": "boolean",
      "optional": true,
      "default": "false",
      "comment": ""
    },
    {
      "name": "bare",
      "type": "boolean",
      "optional": true,
      "default": "false",
      "comment": "Leaves out the card and the title."
    }
  ],
  "emits": [],
  "slots": []
}
