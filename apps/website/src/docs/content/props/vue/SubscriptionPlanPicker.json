{
  "name": "SubscriptionPlanPicker",
  "props": [
    {
      "name": "plans",
      "type": "readonly SubscriptionPlan[]",
      "optional": false,
      "comment": "The plans rendered as cards."
    },
    {
      "name": "recommendedPlanId",
      "type": "string",
      "optional": true,
      "comment": "Highlights one plan as recommended."
    },
    {
      "name": "helperText",
      "type": "string",
      "optional": true,
      "comment": "Helper text under the grid."
    },
    {
      "name": "resource",
      "type": "string",
      "optional": true,
      "comment": "Override the ambient resource (label-key resolution)."
    },
    {
      "name": "isRequired",
      "type": "boolean",
      "optional": true,
      "comment": "Forces the required marker."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "optional": true,
      "comment": "Disables the whole picker."
    },
    {
      "name": "source",
      "type": "string",
      "optional": false,
      "comment": "The field path (dot/bracket), relative to the ambient source scope."
    },
    {
      "name": "label",
      "type": "string | false",
      "optional": true,
      "default": "undefined",
      "comment": "Explicit label, or `false` to hide it. Absent → humanized `source`."
    },
    {
      "name": "defaultValue",
      "type": "unknown",
      "optional": true,
      "comment": "Input-level default (seeds only into a hole), typed as the value at `source`."
    },
    {
      "name": "validate",
      "type": "Validator | readonly Validator[]",
      "optional": true,
      "comment": "ra-contract validators — composed, first error wins."
    }
  ],
  "emits": [],
  "slots": []
}
