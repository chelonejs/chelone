{
  "name": "chelone",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome check --write .",
    "lint": "biome check .",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:type-escapes": "node scripts/check-type-escapes.mjs",
    "check:type-cost": "node scripts/check-type-cost.mjs",
    "check:type-docs": "node scripts/check-type-docs.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:showcase": "node scripts/showcase.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"apps/website/scripts/*.test.mjs\"",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "jscpd": "5.4.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
